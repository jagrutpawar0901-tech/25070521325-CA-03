# SwasthyaOS Environment Variables
# Copy this file to .env in the server directory and fill in actual values.

# ─── Server ─────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── MongoDB ─────────────────────────────────────────────────────────────────
# Use MongoDB Atlas connection string or local MongoDB URI
MONGO_URI=mongodb://localhost:27017/swasthyaos

# ─── JWT / Auth ──────────────────────────────────────────────────────────────
JWT_SECRET=change_me_to_a_long_random_secret_string_min_32_chars
JWT_EXPIRES_IN=7d
COOKIE_SECRET=another_long_random_secret_for_cookie_signing

# ─── Frontend Origin (for CORS) ───────────────────────────────────────────────
CLIENT_URL=http://localhost:5173

# ─── AI Provider (Optional) ──────────────────────────────────────────────────
# Supports Google Gemini or OpenAI. Leave blank to use rule-based fallback.
GEMINI_API_KEY=
OPENAI_API_KEY=

# ─── Razorpay (Optional – Test Mode) ─────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ─── Email / SMTP (Optional) ─────────────────────────────────────────────────
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@swasthyaos.local
